# Backup copies. A backup of a live page is a live page once it is served.
*.backup*
*.bak
*.old
*~

# Test and scratch files kept at the repo root.
/test-*
/scratch-*
/tmp-*
/*.tmp

# Local tooling and secrets.
.claude/
.env
.env.*

# OS and editor cruft.
.DS_Store
Thumbs.db

# Dependencies.
node_modules/

# Database migrations. Nothing SQL is ever served from this host again.
*.sql
